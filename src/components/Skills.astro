---
import type { SkillGroup } from "../data/cv.schema";

interface Props {
  rows: SkillGroup[];
}

const { rows } = Astro.props;
---

<div
  class="flex flex-col gap-3.5 break-inside-avoid"
  itemscope
  itemtype="https://schema.org/ItemList"
>
  {
    rows.map((r) => (
      <div class="grid grid-cols-[110px_1fr] gap-6 items-baseline break-inside-avoid">
        <div class="font-display text-[11px] text-accent uppercase tracking-[0.08em] font-bold">{r.cat}</div>
        <div class="text-ink text-[14.5px] leading-[1.55] text-pretty">
          {r.items.map((it, i) => (
            <>
              {i > 0 && (
                <span class="text-ink-mute mx-2 font-display opacity-50" aria-hidden="true">
                  /
                </span>
              )}
              <span itemprop="itemListElement">{it}</span>
            </>
          ))}
        </div>
      </div>
    ))
  }
</div>
