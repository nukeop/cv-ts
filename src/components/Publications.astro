---
import type { Publication } from "../data/cv.schema";

interface Props {
  items: Publication[];
}

const { items } = Astro.props;
---

<div class="flex flex-col gap-4">
  {
    items.map((p) => (
      <article
        class="grid grid-cols-[110px_1fr] gap-6 break-inside-avoid"
        itemscope
        itemtype="https://schema.org/ScholarlyArticle"
      >
        <div class="font-display text-[11px] text-accent tracking-[0.08em] font-bold pt-0.5">
          <time datetime={p.year} itemprop="datePublished">{p.year}</time>
        </div>
        <div>
          <h3
            class="font-display text-[18px] leading-[1.3] text-ink m-0 mb-0.5 font-bold tracking-[0.01em]"
            itemprop="headline"
          >
            {p.title}
          </h3>
          <div class="font-sans text-[13px] text-ink-soft italic" itemprop="author">{p.authors}</div>
          <div class="font-display text-[11px] text-ink-mute mt-0.5 tracking-[0.04em]">{p.venue}</div>
        </div>
      </article>
    ))
  }
</div>
