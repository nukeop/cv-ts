---
import type { Publication } from "../data/cv.schema";

interface Props {
  items: Publication[];
}

const { items } = Astro.props;
---

<div class="flex flex-col gap-4">
  {
    items.map((p) => (
      <article
        class="grid grid-cols-[110px_1fr] gap-6 break-inside-avoid"
        itemscope
        itemtype="https://schema.org/ScholarlyArticle"
      >
        <div class="font-mono text-[12.5px] text-ink-mute">
          <time datetime={p.year} itemprop="datePublished">{p.year}</time>
        </div>
        <div>
          <h3
            class="font-display text-[20px] leading-[1.3] text-ink m-0 mb-0.5 font-normal tracking-[-0.005em]"
            itemprop="headline"
          >
            {p.title}
          </h3>
          <div class="text-[13px] text-ink-soft italic" itemprop="author">{p.authors}</div>
          <div class="font-mono text-[11.5px] text-ink-mute mt-0.5">{p.venue}</div>
        </div>
      </article>
    ))
  }
</div>
