---
import type { Certification } from "../data/cv.schema";

interface Props {
	items: Certification[];
}

const { items } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-3">
	{
		items.map((c) => (
			<div class="grid grid-cols-[auto_1fr] gap-2.5 items-baseline break-inside-avoid">
				<span class="font-mono text-[11px] text-accent tracking-[0.04em]">{c.year}</span>
				<div>
					<h3 class="text-[14.5px] text-ink m-0 font-medium">{c.name}</h3>
					<div class="text-[12.5px] text-ink-mute font-mono">{c.issuer}</div>
				</div>
			</div>
		))
	}
</div>
