---
import { Icon } from "astro-icon/components";
import type { Job } from "../data/cv.schema";

interface Props {
  jobs: Job[];
}

const { jobs } = Astro.props;
---

<div class="flex flex-col gap-[18px]">
  {
    jobs.map((j) => (
      <article
        class="grid grid-cols-[110px_1fr] gap-6 pb-[18px] border-b border-rule last:border-0 last:pb-0 break-inside-avoid"
        itemprop="worksFor"
        itemscope
        itemtype="https://schema.org/Organization"
      >
        <div class="font-display text-[12px] text-ink-mute pt-1 whitespace-nowrap tracking-[0.04em]">
          <div>
            <time datetime={j.start}>{j.start}</time>
            {" —"}
            <meta itemprop="foundingDate" content={j.start} />
          </div>
          <div>
            {j.end ? (
              <time datetime={j.end}>{j.end}</time>
            ) : (
              <span class="text-accent font-medium inline-flex items-center gap-1.5">
                <span
                  class="inline-block w-[5px] h-[5px] bg-accent"
                  aria-hidden="true"
                />
                Present
              </span>
            )}
          </div>
        </div>
        <div class="min-w-0">
          <h3 class="font-display text-[16px] font-bold text-ink m-0 leading-[1.2] tracking-[0.01em]">
            {j.role}
          </h3>
          {j.promotedFrom && (
            <div class="flex items-center gap-1 mt-0.5 mb-0.5">
              <Icon name="lucide:arrow-up" class="w-[11px] h-[11px] text-accent shrink-0" />
              <span class="font-display text-[11px] text-accent tracking-[0.04em]">
                Promoted from {j.promotedFrom}
              </span>
            </div>
          )}
          <div class="font-sans text-[12.5px] text-ink-soft tracking-[0.005em]">
            {j.url ? (
              <a
                href={j.url}
                target="_blank"
                rel="noreferrer"
                class="text-ink-soft hover:text-accent transition-colors"
                itemprop="name"
              >
                {j.company}
                <span class="inline-block font-display ml-0.5 opacity-55 -translate-y-px">
                  {" ↗"}
                </span>
              </a>
            ) : (
              <span itemprop="name">{j.company}</span>
            )}
          </div>
          {j.description && (
            <p class="mt-2 mb-2 text-ink-soft max-w-[62ch] text-pretty" itemprop="description">
              {j.description}
            </p>
          )}
          {j.highlights && j.highlights.length > 0 && (
            <ul class="list-none m-0 p-0 flex flex-col gap-1">
              {j.highlights.map((h) => (
                <li class="relative pl-[18px] text-ink-soft text-[14.5px] before:content-['—'] before:absolute before:left-0 before:text-ink-mute before:font-display">
                  {h}
                </li>
              ))}
            </ul>
          )}
        </div>
      </article>
    ))
  }
</div>
