---
import type { Job } from "../data/cv.schema";

interface Props {
	jobs: Job[];
}

const { jobs } = Astro.props;
---

<div class="flex flex-col gap-[18px]">
	{
		jobs.map((j) => (
			<article class="grid grid-cols-[110px_1fr] gap-6 pb-[18px] border-b border-dashed border-rule last:border-0 last:pb-0 break-inside-avoid">
				<div class="font-mono text-[12.5px] text-ink-mute pt-1 whitespace-nowrap tracking-[0.01em]">
					<div>{j.start} —</div>
					<div>
						{j.end ? (
							j.end
						) : (
							<span class="text-accent font-medium inline-flex items-center gap-1.5">
								<span
									class="inline-block w-[5px] h-[5px] bg-accent rounded-full"
									aria-hidden="true"
								/>
								Present
							</span>
						)}
					</div>
				</div>
				<div class="min-w-0">
					<div class="flex items-center gap-3 mb-1">
						<div
							class="w-7 h-7 rounded-md bg-accent-soft text-accent flex items-center justify-center font-display text-[15px] font-medium tracking-[-0.01em] shrink-0 border-[0.5px] border-accent/20"
							aria-hidden="true"
						>
							{j.mark}
						</div>
						<div>
							<h3 class="font-sans text-[17px] font-semibold text-ink m-0 leading-[1.2]">
								{j.role}
							</h3>
							<div class="font-sans text-[12.5px] text-ink-soft tracking-[0.005em]">
								{j.url ? (
									<a
										href={j.url}
										target="_blank"
										rel="noreferrer"
										class="text-ink border-b-[0.5px] border-rule hover:border-accent hover:text-accent transition-colors"
									>
										{j.company}
										<span class="inline-block font-mono ml-0.5 opacity-55 -translate-y-px">
											{" ↗"}
										</span>
									</a>
								) : (
									j.company
								)}
							</div>
						</div>
					</div>
					{j.description && (
						<p class="mt-2 mb-2 text-ink-soft max-w-[62ch] text-pretty">{j.description}</p>
					)}
					{j.highlights && j.highlights.length > 0 && (
						<ul class="list-none m-0 p-0 flex flex-col gap-1">
							{j.highlights.map((h) => (
								<li class="relative pl-[18px] text-ink-soft text-[14.5px] before:content-['—'] before:absolute before:left-0 before:text-ink-mute before:font-mono">
									{h}
								</li>
							))}
						</ul>
					)}
				</div>
			</article>
		))
	}
</div>
