---
import "../styles/global.css";
import type { CvData } from "../data/cv.schema";

interface Props {
  title: string;
  cv: CvData;
}

const { title, cv } = Astro.props;

const email = cv.contact.find((c) => c.label === "email")?.href ?? "";
const site = cv.contact.find((c) => c.label === "site")?.href ?? "";
const github = cv.contact.find((c) => c.label === "github")?.href ?? "";

const skillsFlat = cv.skills.flatMap((g) => g.items);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: `${cv.name.first} ${cv.name.last}`,
  givenName: cv.name.first,
  familyName: cv.name.last,
  jobTitle: cv.title,
  email: email.replace("mailto:", ""),
  url: site,
  sameAs: [github].filter(Boolean),
  description: cv.summary,
  knowsAbout: skillsFlat,
  alumniOf: cv.education.map((e) => ({
    "@type": "EducationalOrganization",
    name: e.uni,
    description: e.degree,
  })),
  hasCredential: cv.certifications.map((c) => ({
    "@type": "EducationalOccupationalCredential",
    name: c.name,
    recognizedBy: {
      "@type": "Organization",
      name: c.issuer,
    },
    dateCreated: c.year,
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={cv.summary} />
    <meta property="og:profile:first_name" content={cv.name.first} />
    <meta property="og:profile:last_name" content={cv.name.last} />
    {site && <meta property="og:url" content={site} />}

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 2)} />
  </head>
  <body class="bg-bg text-ink font-sans text-[15px] leading-[1.55] m-0 print:bg-bg">
    <slot />
  </body>
</html>
